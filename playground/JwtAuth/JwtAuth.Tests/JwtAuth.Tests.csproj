<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableMSTestRunner>true</EnableMSTestRunner>
    <!-- Suppress XML doc warnings in test project -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="MSTest" />
  </ItemGroup>

  <ItemGroup>
    <None Include="test.runsettings" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Aspire.Hosting.DevJwt\Aspire.Hosting.DevJwt.csproj" />
    <ProjectReference Include="..\..\..\src\Aspire.Testing.MSTest\Aspire.Testing.MSTest.csproj" />
    <ProjectReference Include="..\JwtAuth.AppHost\JwtAuth.AppHost.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\JwtAuth.ServiceDefaults\JwtAuth.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
