<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>a1b2c3d4-e5f6-7890-abcd-ef1234567890</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JwtAuth.ApiOne\JwtAuth.ApiOne.csproj" />
    <ProjectReference Include="..\JwtAuth.ApiTwo\JwtAuth.ApiTwo.csproj" />
    <ProjectReference Include="..\..\..\src\Aspire.Hosting.DevJwt\Aspire.Hosting.DevJwt.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <!--
    The test project is added at runtime via AddProject("tests", path) because a typed
    AddProject<TProject> would require a ProjectReference here, creating a circular
    dependency (Tests already references this AppHost).

    We use Exec (out-of-process dotnet build) instead of the MSBuild task to avoid the
    in-process circular-dependency error. The guard property BuildingFromAppHost is
    propagated as a global property, so when the test project transitively builds *this*
    AppHost the target is skipped, breaking the cycle.
  -->
  <Target Name="BuildPathReferencedProjects" AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(BuildingFromAppHost)' != 'true'">
    <Exec Command='dotnet build "$(MSBuildThisFileDirectory)..\JwtAuth.Tests\JwtAuth.Tests.csproj" -c $(Configuration) -p:BuildingFromAppHost=true' />
  </Target>

</Project>
