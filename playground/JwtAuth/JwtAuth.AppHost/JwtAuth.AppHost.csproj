<Project Sdk="Aspire.AppHost.Sdk/13.2.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>a1b2c3d4-e5f6-7890-abcd-ef1234567890</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\JwtAuth.ApiOne\JwtAuth.ApiOne.csproj" />
    <ProjectReference Include="..\JwtAuth.ApiTwo\JwtAuth.ApiTwo.csproj" />
    <ProjectReference Include="..\..\..\src\Aspire.Hosting.DevJwt\Aspire.Hosting.DevJwt.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <!--
    The test project is added at runtime via AddProject("tests", path) because a typed
    AddProject<TProject> would require a ProjectReference here, creating a circular
    dependency (Tests already references this AppHost). Build it explicitly so that a
    clean checkout + F5 produces the test binary before the resource is started.
  
  <Target Name="BuildPathReferencedProjects" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\JwtAuth.Tests\JwtAuth.Tests.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>
  -->

</Project>
